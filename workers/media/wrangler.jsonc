{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cosmos-universe-media",
  "main": "src/index.ts",
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": false
  },
  "vars": {
    "MEDIA_DELIVERY_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "2026102601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "cosmos-universe-public-media"
    }
  ]
}
